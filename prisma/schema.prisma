generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  role      Role       @default(USER)
  updatedAt DateTime   @updatedAt
  username  String     @unique
  dossier   Dossier[]
  evidence  Evidence[]
}

model Dossier {
  id             String     @id @default(dbgenerated("gen_random_uuid()"))
  code           String     @unique
  title          String
  description    String
  status         String     @default("Open")
  author         String
  description_en String?
  title_en       String?
  coverUrl       String
  user           User       @relation(fields: [author], references: [id])
  evidences      Evidence[]
  timeline       Timeline[]
}

model Evidence {
  id        String         @id @default(dbgenerated("gen_random_uuid()"))
  dossierId String
  type      EvidenceType   @default(PHOTO)
  fileUrl   String
  notes     String
  author    String
  notes_en  String?
  status    EvidenceStatus @default(PENDING)
  user      User           @relation(fields: [author], references: [id])
  dossier   Dossier        @relation(fields: [dossierId], references: [code])
}

model Timeline {
  id             String   @id @default(uuid())
  date           DateTime
  title          String
  description    String   @db.VarChar(255)
  dossierId      String
  description_en String?  @db.VarChar(255)
  title_en       String?
  dossier        Dossier  @relation(fields: [dossierId], references: [code], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum EvidenceType {
  PHOTO
  PDF
  AUDIO
  DOCUMENT
}

enum EvidenceStatus {
  PENDING
  REJECTED
  ACCEPTED
}
